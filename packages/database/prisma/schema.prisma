generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

enum CrmCustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

enum CrmLeadStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ErpInvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum ErpExpenseStatus {
  PENDING
  APPROVED
  PAID
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model User {
  id              String                @id @default(cuid())
  email           String                @unique
  name            String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  disabledAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  memberships     OrganizationMember[]
  sessions        Session[]
  auditEvents     AuditEvent[]          @relation("AuditActor")
  sentInvitations OrganizationInvitation[] @relation("InvitationSender")

  @@index([createdAt])
}

model Organization {
  id          String                @id @default(cuid())
  name        String
  slug        String                @unique
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  memberships OrganizationMember[]
  auditEvents AuditEvent[]
  departments Department[]
  employees Employee[]
  invitations OrganizationInvitation[]
  crmCustomers CrmCustomer[]
  crmContacts CrmContact[]
  crmLeads CrmLead[]
  erpInvoices ErpInvoice[]
  erpExpenses ErpExpense[]

  @@index([createdAt])
}

model OrganizationMember {
  id             String         @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, role])
  @@index([organizationId, role])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  tokenHash        String   @unique
  expiresAt        DateTime
  lastSeenAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  entityType     String?
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?        @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
}


model Department {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees      Employee[]

  @@unique([organizationId, name])
  @@index([organizationId, createdAt])
}

model Employee {
  id             String           @id @default(cuid())
  organizationId String
  departmentId   String?
  employeeCode   String
  firstName      String
  lastName       String
  workEmail      String?
  jobTitle       String?
  status         EmploymentStatus @default(ACTIVE)
  startDate      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department     Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, workEmail])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, departmentId])
}


model OrganizationInvitation {
  id             String         @id @default(cuid())
  organizationId String
  inviterUserId  String
  email          String
  role           MembershipRole @default(MEMBER)
  tokenHash      String         @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User           @relation("InvitationSender", fields: [inviterUserId], references: [id], onDelete: Cascade)

  @@index([organizationId, email, createdAt])
  @@index([expiresAt, acceptedAt, revokedAt])
}


model CrmCustomer {
  id String @id @default(cuid())
  organizationId String
  name String
  industry String?
  website String?
  email String?
  phone String?
  status CrmCustomerStatus @default(PROSPECT)
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts CrmContact[]
  leads CrmLead[]
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, name])
}

model CrmContact {
  id String @id @default(cuid())
  organizationId String
  customerId String
  firstName String
  lastName String
  email String?
  phone String?
  jobTitle String?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer CrmCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  leads CrmLead[]
  @@index([organizationId, customerId])
  @@index([organizationId, lastName, firstName])
}

model CrmLead {
  id String @id @default(cuid())
  organizationId String
  customerId String?
  contactId String?
  title String
  estimatedValueCents Int @default(0)
  stage CrmLeadStage @default(NEW)
  source String?
  expectedCloseDate DateTime?
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer CrmCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contact CrmContact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  @@index([organizationId, stage, updatedAt])
  @@index([organizationId, customerId])
}


model ErpInvoice {
  id             String           @id @default(cuid())
  organizationId String
  invoiceNumber  String
  customerName   String
  issueDate      DateTime         @default(now())
  dueDate        DateTime?
  amountCents    Int
  status         ErpInvoiceStatus @default(DRAFT)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, updatedAt])
  @@index([organizationId, dueDate])
}

model ErpExpense {
  id             String           @id @default(cuid())
  organizationId String
  title          String
  vendor         String?
  category       String
  incurredAt     DateTime         @default(now())
  amountCents    Int
  status         ErpExpenseStatus @default(PENDING)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, incurredAt])
  @@index([organizationId, category])
}
